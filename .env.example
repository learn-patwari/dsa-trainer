# Copy to .env (never commit it). Everything here is optional.

# API server port (the Vite dev server on 5178 proxies /api here; `npm start` serves everything here).
API_PORT=5179

# Optional: import your COMPLETE solved list from LeetCode.
# In a browser where you're signed in to leetcode.com, open DevTools ->
# Application -> Cookies -> https://leetcode.com and copy these two values.
# They are only ever sent to leetcode.com. Treat them like a password.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=
